--!strict
return function()
 local ChapterService = require(script.Parent.Parent.ChapterService)
 local chapter = {id="vs01",objectives={{id="a"},{id="b"},{id="c"}}}
 local service, player, count = ChapterService.new(chapter), {}, 0
 local function check(condition,message) assert(condition,message); count+=1 end
 service:reset(player)
 check(type(service.enterMenu)=="function","RED: enterMenu belum tersedia")
 check(not service:enterMenu(player,999),"Revision salah ditolak")
 check(service:enterMenu(player,service:snapshot(player).revision),"Menu awal dapat dibuka")
 local initial = service:snapshot(player)
 check(initial.phase=="menu" and not initial.hasCheckpoint,"Menu awal tidak mengarang progres")
 check(not service:resume(player,initial.revision),"Resume tanpa checkpoint ditolak")
 check(not service:startChapter(player,initial.revision,"locked"),"Chapter terkunci ditolak server")
 check(not service:startChapter(player,initial.revision-1,"vs01"),"Request lama ditolak")
 check(service:startChapter(player,initial.revision,"vs01"),"VS01 dapat dimulai")
 check(service:snapshot(player).phase=="title","Mulai membuka intro chapter")
 check(not service:startChapter(player,service:snapshot(player).revision,"vs01"),"Duplikasi start ditolak")
 service:acknowledge(player,service:snapshot(player).revision)
 service:interact(player,"a")
 service:acknowledge(player,service:snapshot(player).revision)
 check(service:enterMenu(player,service:snapshot(player).revision),"Gameplay bisa kembali ke menu")
 local paused = service:snapshot(player)
 check(paused.hasCheckpoint and paused.checkpointIndex==2,"Checkpoint menunjuk objektif aktif kedua")
 check(not service:interact(player,"b"),"Menu membekukan interaksi")
 check(service:resume(player,paused.revision),"Checkpoint nyata dapat dilanjutkan")
 check(service:snapshot(player).phase=="exploring" and service:snapshot(player).objectiveIndex==2,"Resume awal objektif aktif")
 check(not service:resume(player,paused.revision),"Duplikasi resume ditolak")
 for _,id in ipairs({"b","c"}) do service:interact(player,id); service:acknowledge(player,service:snapshot(player).revision) end
 local closing = service:snapshot(player)
 service:enterMenu(player,closing.revision)
 check(not service:finishCinematic(player,closing.revision),"Timer cutscene sebelum menu ditolak")
 service:resume(player,service:snapshot(player).revision)
 check(service:snapshot(player).objectiveIndex==3,"Resume cutscene mengulang objektif terakhir")
 service:interact(player,"c"); service:acknowledge(player,service:snapshot(player).revision)
 service:finishCinematic(player,service:snapshot(player).revision)
 service:enterMenu(player,service:snapshot(player).revision)
 check(not service:snapshot(player).hasCheckpoint,"Selesai demo tidak menawarkan checkpoint palsu")
 service:fail(player,"test")
 check(service:enterMenu(player,service:snapshot(player).revision),"Error masih dapat kembali ke menu")
 service:remove(player)
 check(service:snapshot(player)==nil and service.checkpoints[player]==nil,"Cleanup membuang checkpoint sesi")
 return tostring(count).." assertions PASS"
end
